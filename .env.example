# Copy to .env (git-ignored) before running `docker compose -f docker-compose.dev.yml up -d`.
# These values are for LOCAL DEVELOPMENT ONLY — never reuse them anywhere else.

# --- SQL Server ---------------------------------------------------------------
# SQL Server rejects weak passwords: >= 8 chars with upper case, lower case,
# digit and symbol. Change this before the first `up` — it is baked into the
# volume on first start, and changing it later requires `down -v`.
MSSQL_SA_PASSWORD=CHANGE-ME-Str0ng!
MSSQL_PORT=1433

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=change-me-locally
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Application overrides ----------------------------------------------------
# The apps read configuration from environment variables too (`__` = section
# separator). Uncomment to run the hosts without user-secrets — see README.
# ConnectionStrings__ChatDatabase=Server=localhost,1433;Database=ChatDb;User Id=sa;Password=CHANGE-ME-Str0ng!;Encrypt=True;TrustServerCertificate=True
# RabbitMq__UserName=chat
# RabbitMq__Password=change-me-locally

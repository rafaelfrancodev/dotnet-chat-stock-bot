{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "127.0.0.1",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "",
    "Password": ""
  },
  "Stocks": {
    // Finnhub or Stooq. Finnhub needs Finnhub:ApiKey from user-secrets; Stooq needs no key but its CSV
    // endpoint is no longer readable from a server. See README -> Quote providers.
    "Provider": "Finnhub"
  },
  "Finnhub": {
    // Set via user-secrets or Finnhub__ApiKey. Never committed. Sent as the X-Finnhub-Token header, so it
    // never appears in a URL — hence no placeholder for it below.
    "ApiKey": "",
    "BaseAddress": "https://finnhub.io/",
    "QuotePath": "api/v1/quote?symbol={0}",
    "TimeoutSeconds": 10
  },
  "Stooq": {
    "BaseAddress": "https://stooq.com/",
    "QuotePath": "q/d/l/?s={0}&i=d",
    "TimeoutSeconds": 10
  }
}

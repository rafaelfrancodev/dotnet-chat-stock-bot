{
  "Logging": {
    "LogLevel": {
      // Overrides only. The base file already sets Default and Microsoft.Hosting.Lifetime; repeating them
      // here would just be a second place to keep in step.
      //
      // The bot's own lookups at Debug, because a local /stock= round trip is what you are watching; the
      // bus at Warning, because MassTransit narrates every endpoint it configures at startup.
      "Chat": "Debug",
      "MassTransit": "Warning"
    }
  }
}

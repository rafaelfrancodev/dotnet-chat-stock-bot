@page
@using Chat.Domain.Messages
@using Chat.Web.Hubs
@model ChatModel
@{
    ViewData["Title"] = "Chat";
}

<h1>@ViewData["Title"]</h1>

@* Every value here is written by Razor, which HTML-encodes it. Message text is never rendered on the
   server at all: the client appends it with textContent. *@
@if (Model.Room is null)
{
    <p class="text-danger">
        No chat room is available yet. Start the application once with the database reachable so the
        default room is created.
    </p>
}
else
{
    <p>Signed in as <strong>@Model.DisplayName</strong> in <strong>@Model.Room.Name</strong>.</p>

    <div id="chat" data-room-id="@Model.Room.Id" data-hub-url="@ChatHub.Route">
        @* Hidden until the server sends an alert. The text is set by the client with textContent. *@
        <div id="chat-alert" class="alert alert-danger d-none" role="alert" aria-live="assertive">
            <span id="chat-alert-text"></span>
            <button id="chat-alert-dismiss" type="button" class="btn-close float-end" aria-label="Dismiss"></button>
        </div>

        <ul id="chat-messages" class="list-unstyled border rounded p-2 mb-2 overflow-auto" style="height: 24rem"></ul>

        <form id="chat-form" class="d-flex gap-2">
            <label class="visually-hidden" for="chat-input">Message</label>
            <input id="chat-input" class="form-control" type="text" autocomplete="off"
                   maxlength="@MessageConstants.MaxContentLength"
                   placeholder="Type a message, or /stock=aapl.us" />
            <button class="btn btn-primary" type="submit">Send</button>
        </form>

        <p id="chat-status" class="text-muted small mt-2" role="status"></p>
    </div>
}

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}

<Project>

  <!-- Shared compiler settings for every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unused usings) to be reported on build.
         CS1591 is suppressed: XML docs are required on public contracts by review, not by the compiler. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Must stay false: Microsoft.Data.SqlClient throws "Globalization Invariant Mode is not
         supported" at connection time, so EF Core and the SQL Server health check both fail under it.
         Culture-sensitive parsing is still avoided in code by using InvariantCulture explicitly. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!-- Test projects are never packed and may keep xUnit's analyzer noise at warning level. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <!-- One test host at a time. `dotnet test` at the root otherwise runs the unit and integration
         assemblies concurrently, and the integration suite's SignalR-over-TestServer waits have stalled
         under that contention while passing on their own. See tests.runsettings. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
